// Firestore Security Rules for FR8X-CON
// Role-based access control, server-verified writes for privileged collections

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isGodMode() {
      return isAuthenticated() && getUserData().isGodMode == true;
    }
    
    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }
    
    function isValidTimestamp(field) {
      return field is timestamp;
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isGodMode();
      allow delete: if isGodMode();
    }
    
    // Profiles collection
    match /profiles/{profileId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(profileId);
      allow update: if isOwner(profileId) || isGodMode();
      allow delete: if isGodMode();
    }
    
    // Companies collection
    match /companies/{companyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isGodMode();
      allow delete: if isGodMode();
    }
    
    // Posts collection
    match /posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.authorId == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isGodMode());
    }
    
    // Comments collection
    match /comments/{commentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.authorId == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isGodMode());
    }
    
    // Likes collection
    match /likes/{likeId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // Bookmarks collection
    match /bookmarks/{bookmarkId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // Auctions - server-verified writes only for critical operations
    match /auctions/{auctionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.creatorId == request.auth.uid || isGodMode()
      );
      allow delete: if isGodMode();
    }
    
    // Auction participants
    match /auctionParticipants/{participantId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isGodMode();
    }
    
    // Bids - server-verified via Cloud Functions
    // Client can read own bids; writes go through Cloud Functions
    match /bids/{bidId} {
      allow read: if isAuthenticated() && (
        resource.data.participantId == request.auth.uid || isGodMode()
      );
      // Writes are done via Cloud Functions only
      allow write: if false;
    }
    
    // Live Ranks - read-only for clients
    match /liveRanks/{rankId} {
      allow read: if isAuthenticated();
      // Writes are done via Cloud Functions only
      allow write: if false;
    }
    
    // Rates
    match /rates/{rateId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.submittedBy == request.auth.uid || isGodMode()
      );
      allow delete: if isGodMode();
    }
    
    // Awards - admin-only writes
    match /awards/{awardId} {
      allow read: if isAuthenticated();
      allow write: if isGodMode();
    }
    
    // Blacklists - admin-only writes
    match /blacklists/{blacklistId} {
      allow read: if isAuthenticated();
      allow write: if isGodMode();
    }
    
    // Currencies - server-managed
    match /currencies/{currencyId} {
      allow read: if isAuthenticated();
      allow write: if false; // Server-managed via Cloud Functions
    }
    
    // Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false; // Server-managed
    }
    
    // Audit log - append-only, no client deletes
    match /audit/{logId} {
      allow read: if isGodMode();
      allow create: if isAuthenticated();
      allow update: if false;
      allow delete: if false;
    }
    
    // Settings - admin-only
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isGodMode();
    }
    
    // Logs
    match /logs/{logId} {
      allow read: if isGodMode();
      allow create: if isAuthenticated();
      allow update: if false;
      allow delete: if false;
    }

    // Locations - general reads, admin-only writes
    match /locations/{locationId} {
      allow read: if isAuthenticated();
      allow create, update: if isGodMode();
      allow delete: if isGodMode();
    }

    // Location Audit - admin reads, append-only writes
    match /location_audit/{auditId} {
      allow read: if isGodMode();
      allow create: if isAuthenticated();
      allow update: if false;
      allow delete: if false;
    }
  }
}
