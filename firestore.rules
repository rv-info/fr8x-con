rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // AUTHENTICATION & ACCESS CONTROL HELPER FUNCTIONS
    // =========================================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isGodfather() {
      return isAuthenticated() && (
        ('email' in request.auth.token && (request.auth.token.email == 'tech@fr8x.in' || request.auth.token.email == 'operator@fr8x.in')) ||
        ('godfatherAccess' in request.auth.token && request.auth.token.godfatherAccess == true) || 
        ('role' in request.auth.token && (request.auth.token.role == 'godfather' || request.auth.token.role == 'super_admin'))
      );
    }

    function isPlatformAdmin() {
      return isAuthenticated() && (
        ('role' in request.auth.token && request.auth.token.role == 'super_admin') ||
        isGodfather()
      );
    }

    function hasGodfatherRole(subrole) {
      return isGodfather() && (
        'subrole' in request.auth.token && 
        (request.auth.token.subrole == subrole || request.auth.token.subrole == 'godfather_owner')
      );
    }

    // =========================================================================
    // 1. CANONICAL USER COLLECTIONS & SUBCOLLECTIONS
    // =========================================================================

    match /users/{userId} {
      // Authenticated users can read basic profile info for member directory; non-owners cannot see sensitive subdocs
      allow read: if isOwner(userId) || isPlatformAdmin();
      allow create: if isOwner(userId) || isPlatformAdmin();
      allow update: if isPlatformAdmin() || (
        isOwner(userId) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'isAdmin', 'approvalStatus', 'isBlacklisted', 'isGodfather'
        ])
      );
      // Strictly prohibit destructive deletion of business user records
      allow delete: if isPlatformAdmin();

      match /profile/{docId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId) || isPlatformAdmin();
      }

      match /kyc/{docId} {
        allow read: if isOwner(userId) || isPlatformAdmin();
        allow create: if isOwner(userId) || isPlatformAdmin();
        allow update: if isPlatformAdmin() || (isOwner(userId) && resource.data.kycStatus != 'APPROVED' && request.resource.data.kycStatus != 'APPROVED');
        allow delete: if isPlatformAdmin();
      }

      match /approval/{docId} {
        allow read: if isOwner(userId) || isPlatformAdmin();
        allow create: if (isOwner(userId) && request.resource.data.approvalStatus == 'PENDING_APPROVAL') || isPlatformAdmin();
        allow update, delete: if isPlatformAdmin();
      }

      match /security/{docId} {
        allow read: if isOwner(userId) || isPlatformAdmin();
        allow write: if isOwner(userId) || isPlatformAdmin();
      }

      match /preferences/{docId} {
        allow read: if isOwner(userId) || isPlatformAdmin();
        allow write: if isOwner(userId) || isPlatformAdmin();
      }

      match /{subcollection=**} {
        allow read: if isOwner(userId) || isPlatformAdmin();
        allow write: if isOwner(userId) || isPlatformAdmin();
      }
    }

    // Legacy Profiles Root Collection (Read restricted to authenticated, write restricted to owner)
    match /profiles/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isPlatformAdmin();
    }

    // =========================================================================
    // 2. CANONICAL COMPANIES & ENTITY GOVERNANCE
    // =========================================================================

    match /companies/{companyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isPlatformAdmin() || (
        isAuthenticated() && 
        (resource.data.createdById == request.auth.uid || request.auth.uid in resource.data.adminUids) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'approvalStatus', 'status', 'isBlacklisted', 'isVerified'
        ])
      );
      allow delete: if isPlatformAdmin();

      match /members/{memberUid} {
        allow read: if isAuthenticated();
        allow write: if isOwner(memberUid) || isPlatformAdmin() || (
          isAuthenticated() && 
          request.auth.uid in get(/databases/$(database)/documents/companies/$(companyId)).data.adminUids
        );
      }

      match /kyc/{docId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update: if isPlatformAdmin() || (isAuthenticated() && request.resource.data.kycStatus != 'APPROVED');
        allow delete: if isPlatformAdmin();
      }

      match /approval/{docId} {
        allow read: if isAuthenticated();
        allow create: if (isAuthenticated() && request.resource.data.approvalStatus == 'PENDING_APPROVAL') || isPlatformAdmin();
        allow update, delete: if isPlatformAdmin();
      }

      match /audit/{auditId} {
        allow read: if isPlatformAdmin() || (
          isAuthenticated() && (
            get(/databases/$(database)/documents/companies/$(companyId)).data.createdById == request.auth.uid ||
            request.auth.uid in get(/databases/$(database)/documents/companies/$(companyId)).data.adminUids
          )
        );
        allow create: if isAuthenticated();
        allow update, delete: if false; // Cryptographic append-only immutability
      }
    }

    // Organizations (Legacy compatibility)
    match /organizations/{organizationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isPlatformAdmin() || (isAuthenticated() && request.auth.uid in resource.data.adminUids);
      allow delete: if isPlatformAdmin();

      match /members/{memberId} {
        allow read: if isAuthenticated();
        allow write: if isPlatformAdmin() || (
          isAuthenticated() && 
          request.auth.uid in get(/databases/$(database)/documents/organizations/$(organizationId)).data.adminUids
        );
      }
    }

    // =========================================================================
    // 3. SOCIAL FEED & PROFESSIONAL ACTIVITY
    // =========================================================================

    match /posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.authorUid == request.auth.uid;
      allow update: if isPlatformAdmin() || (
        isAuthenticated() && (
          (isOwner(resource.data.authorUid) && !resource.data.isAuctionAnnouncement && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['likes', 'likesCount', 'dis', 'dislikesCount', 'comments'])) ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'likes', 'likesCount', 'dis', 'dislikesCount',
            'liked', 'likedBy', 'disliked', 'dislikedBy',
            'isSaved', 'savedBy', 'comments', 'commentCount',
            'reposts', 'repostCount', 'updatedAt'
          ])
        )
      );
      allow delete: if isOwner(resource.data.authorUid) || isPlatformAdmin();
      
      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.authorUid == request.auth.uid;
        allow update: if isPlatformAdmin() || (
          isAuthenticated() && (
            isOwner(resource.data.authorUid) ||
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'likedBy', 'dislikedBy', 'likesCount', 'dislikesCount', 'likes', 'dis'
            ])
          )
        );
        allow delete: if isOwner(resource.data.authorUid) || isPlatformAdmin();
      }
    }

    match /threads/{threadId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if isPlatformAdmin() || (isAuthenticated() && resource.data.authorUid == request.auth.uid);
    }

    match /feeds/{feedId} {
      allow read: if isAuthenticated();
      allow write: if isPlatformAdmin();
    }

    // =========================================================================
    // 4. RATES ENGINE
    // =========================================================================

    match /rates/{rateId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
      // Allow author or admin to update/expire rates
      allow update: if isOwner(resource.data.ownerUid) || isPlatformAdmin();
      // Rates deletion disabled — enforce "Expire" instead of hard deletion
      allow delete: if isPlatformAdmin();
    }

    // =========================================================================
    // 5. REVERSE AUCTIONS & LIVE BIDDING
    // =========================================================================

    match /auctions/{auctionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.creatorUid == request.auth.uid;
      allow update: if (
        isOwner(resource.data.creatorUid) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['publishedAt', 'creatorUid'])
      ) || isPlatformAdmin() || (
        // Allow authenticated bidders to update bid-aggregation fields atomically during bid transaction
        isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bidCount', 'currentLowestBid', 'updatedAt'])
      );
      allow delete: if isPlatformAdmin();

      match /bids/{bidId} {
        allow read: if isAuthenticated() && (
          isOwner(resource.data.bidderUid) || 
          isOwner(get(/databases/$(database)/documents/auctions/$(auctionId)).data.creatorUid) ||
          isPlatformAdmin()
        );
        allow create: if isAuthenticated() && request.resource.data.bidderUid == request.auth.uid;
        allow update: if isPlatformAdmin();
        allow delete: if false; // Bids are immutable legal records
      }

      match /audit/{auditId} {
        allow read: if isAuthenticated() && (
          isOwner(get(/databases/$(database)/documents/auctions/$(auctionId)).data.creatorUid) || 
          isPlatformAdmin()
        );
        allow create: if isAuthenticated();
        allow update, delete: if false;
      }
    }

    match /auctionBids/{bidId} {
      allow read: if isAuthenticated() && (resource.data.bidderUid == request.auth.uid || isPlatformAdmin());
      allow create: if isAuthenticated() && request.resource.data.bidderUid == request.auth.uid;
      allow update, delete: if isPlatformAdmin();
    }

    match /bidderGroups/{groupId} {
      // Separate create from read/update/delete to avoid resource.data access on non-existent doc
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
      allow read, update, delete: if isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid ||
        isPlatformAdmin()
      );
    }

    // =========================================================================
    // 6. NEXUS COMMUNICATIONS, REVIEWS & DISPUTES
    // =========================================================================

    match /nexusTopics/{topicId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.authorUid == request.auth.uid;
      allow update: if isPlatformAdmin() || (
        isAuthenticated() && (
          isOwner(resource.data.authorUid) ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'views', 'upvotes', 'downvotes', 'replyCount', 'lastActivityAt'
          ])
        )
      );
      allow delete: if isOwner(resource.data.authorUid) || isPlatformAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isPlatformAdmin();
    }

    match /blacklistCases/{caseId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.reporterUid == request.auth.uid;
      allow update, delete: if isPlatformAdmin();
    }

    match /blacklist/{entryId} {
      allow read: if isAuthenticated();
      allow write: if isPlatformAdmin();
    }

    match /reports/{reportId} {
      allow read: if isPlatformAdmin() || isOwner(resource.data.reporterUid);
      allow create: if isAuthenticated() && request.resource.data.reporterUid == request.auth.uid;
      allow update, delete: if isPlatformAdmin();
    }

    // Real-time Text Conversations (No file attachments allowed)
    match /conversations/{conversationId} {
      // Separate create from read/write to avoid resource.data access on non-existent conversation doc
      allow create: if isAuthenticated() &&
        request.auth.uid in request.resource.data.participantUids;
      allow read, update: if isAuthenticated() &&
        request.auth.uid in resource.data.participantUids;
      allow delete: if isPlatformAdmin();

      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids
        );
        allow create: if isAuthenticated() && (
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids
        ) && request.resource.data.senderUid == request.auth.uid;
        allow update: if isAuthenticated() && (
          isOwner(resource.data.senderUid) ||
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids
        ) && request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'status', 'readAt', 'isEdited', 'text', 'readBy'
        ]);
        allow delete: if isOwner(resource.data.senderUid) || isPlatformAdmin();
      }
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        resource.data.recipientUid == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isPlatformAdmin()
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.recipientUid == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isPlatformAdmin()
      ) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt', 'status']);
      allow delete: if isAuthenticated() && (
        resource.data.recipientUid == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isPlatformAdmin()
      );
    }

    match /contacts/{contactId} {
      // Separate create from read/update/delete to avoid resource.data access on non-existent doc
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isAuthenticated() && (
        resource.data.uid == request.auth.uid ||
        isPlatformAdmin()
      );
    }

    // =========================================================================
    // 7. GODFATHER & SYSTEM ADMINISTRATION
    // =========================================================================

    // Immutable Platform Audit Records (Append-Only)
    match /adminActions/{actionId} {
      allow read: if isGodfather();
      allow create: if isGodfather();
      allow update, delete: if false; // Cryptographic Immutability
    }

    match /adminCases/{caseId} {
      allow read, write: if isGodfather();
    }

    match /adminSessions/{sessionId} {
      allow read, write: if isGodfather();
    }

    match /planVersions/{planVersionId} {
      allow read: if isAuthenticated();
      allow create, update: if hasGodfatherRole('godfather_finance');
      allow delete: if false;
    }

    match /paymentConfigs/{configId} {
      allow read, write: if hasGodfatherRole('godfather_finance');
    }

    match /pricingPlans/{planId} {
      allow read: if isAuthenticated();
      allow write: if hasGodfatherRole('godfather_finance');
    }

    match /promotionalSettings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isPlatformAdmin();
    }

    match /blockActions/{blockId} {
      allow read: if isAuthenticated();
      allow create, update: if isGodfather();
      allow delete: if false;
    }

    match /securityEvents/{eventId} {
      allow read: if isGodfather();
      allow create: if isAuthenticated() || isGodfather();
      allow update, delete: if false;
    }

    match /emailLogs/{logId} {
      allow read: if isGodfather();
      allow create: if isGodfather();
      allow update, delete: if false;
    }

    // Server-Only Authentication & Security Collections (Client-Writable: FORBIDDEN)
    match /securityLoginAttempts/{attemptId} {
      allow read: if isGodfather();
      allow write: if false;
    }

    match /securityOtps/{otpId} {
      allow read, write: if false;
    }

    match /emailEvents/{eventId} {
      allow read: if isGodfather();
      allow write: if false;
    }

    match /auditLogs/{logId} {
      allow read: if isGodfather();
      allow write: if false;
    }

    // Logistics Signals, Presence & Intent
    match /presence/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isPlatformAdmin();
    }

    match /rankingConfigs/{configId} {
      allow read: if isAuthenticated();
      allow write: if isPlatformAdmin();
    }

    match /intents/{userId} {
      allow read, write: if isOwner(userId) || isPlatformAdmin();
    }

    match /events/{eventId} {
      allow read: if isPlatformAdmin();
      allow create: if isAuthenticated() && request.resource.data.actorId == request.auth.uid;
      allow update, delete: if false;
    }

    // Freight Jobs & Applications
    match /jobs/{jobId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.posterUid == request.auth.uid;
      allow update, delete: if isOwner(resource.data.posterUid) || isPlatformAdmin();
    }

    match /jobApplications/{appId} {
      allow read: if isPlatformAdmin() || (
        isAuthenticated() && (
          resource.data.applicantUid == request.auth.uid || 
          resource.data.posterUid == request.auth.uid
        )
      );
      allow create: if isAuthenticated() && request.resource.data.applicantUid == request.auth.uid;
      allow update, delete: if isPlatformAdmin() || (
        isAuthenticated() && resource.data.applicantUid == request.auth.uid
      );
    }

    match /supportTickets/{ticketId} {
      allow read: if isPlatformAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isPlatformAdmin() || (
        isAuthenticated() && 
        resource.data.userId == request.auth.uid && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['message', 'updatedAt', 'comments'])
      );
      allow delete: if isPlatformAdmin();
    }

    match /ads/{adId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isPlatformAdmin();
    }

    // =========================================================================
    // 8. STRICT LEAST-PRIVILEGE CATCH-ALL (DEFAULT DENY)
    // =========================================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
