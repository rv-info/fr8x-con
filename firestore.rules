rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isVerifiedUser() {
      return isAuthenticated() && (request.auth.token.isVerified == true || request.auth.token.email_verified == true);
    }
    
    function isPlatformAdmin() {
      return isAuthenticated() && (request.auth.token.role == 'super_admin' || isGodfather());
    }

    function isGodfather() {
      return isAuthenticated() && (request.auth.token.godfatherAccess == true || request.auth.token.role == 'godfather');
    }

    function hasGodfatherRole(subrole) {
      return isGodfather() && (request.auth.token.subrole == subrole || request.auth.token.subrole == 'godfather_owner');
    }

    // =========================================================================
    // GODFATHER SUPER ADMIN COLLECTIONS & IMMUTABLE LEDGERS
    // =========================================================================

    // Immutable Platform Audit Records (Append-Only)
    match /adminActions/{actionId} {
      allow read: if isGodfather();
      allow create: if isGodfather();
      allow update, delete: if false; // Strict Cryptographic Immutability
    }

    // Support & Compliance Investigation Cases
    match /adminCases/{caseId} {
      allow read, write: if isGodfather();
    }

    // Versioned Subscription Pricing Plans (Append-Only Forward Effective)
    match /planVersions/{planVersionId} {
      allow read: if isAuthenticated();
      allow create, update: if hasGodfatherRole('godfather_finance');
      allow delete: if false;
    }

    // Payment Gateway Integrations & Vault Config References
    match /paymentConfigs/{configId} {
      allow read, write: if hasGodfatherRole('godfather_finance');
    }

    // Granular Member & Company Scoped Blocks
    match /blockActions/{blockId} {
      allow read: if isAuthenticated();
      allow create, update: if isGodfather();
      allow delete: if false;
    }

    // System Notification & Message Templates
    match /notificationTemplates/{templateId} {
      allow read: if isAuthenticated();
      allow create, update: if isGodfather();
      allow delete: if hasGodfatherRole('godfather_owner');
    }

    // Zoho Outbound Email Delivery Logs (Append-Only)
    match /emailLogs/{logId} {
      allow read: if isGodfather();
      allow create: if isGodfather();
      allow update, delete: if false; // Strict Cryptographic Immutability
    }

    // Privileged Admin Operator Sessions
    match /adminSessions/{sessionId} {
      allow read, write: if isGodfather();
    }

    // Platform Security & Lockout Event Ledger (Append-Only)
    match /securityEvents/{eventId} {
      allow read: if isGodfather();
      allow create: if isAuthenticated() || isGodfather();
      allow update, delete: if false; // Strict Cryptographic Immutability
    }

    // =========================================================================
    // PLATFORM USER & ENTITY COLLECTIONS
    // =========================================================================

    // Users Collection (Profile metadata & Entitlements)
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isPlatformAdmin() || (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['plan', 'isVerified', 'hasGoldenTick', 'role']));
      allow delete: if isPlatformAdmin();
    }

    // Profiles Collection (Professional history, Experience, Education, Certifications)
    match /profiles/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isPlatformAdmin();
    }

    // Feed Posts & Threaded Comments (Post -> Comment -> Reply -> Reply-to-Reply)
    match /posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.authorUid == request.auth.uid;
      allow update: if isPlatformAdmin() || (isAuthenticated() && (
        (isOwner(resource.data.authorUid) && !resource.data.isAuctionAnnouncement && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['likes', 'dis', 'comments'])) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'dis', 'liked', 'disliked', 'isSaved', 'comments'])
      ));
      allow delete: if isOwner(resource.data.authorUid) || isPlatformAdmin();
      
      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.authorUid == request.auth.uid;
        allow update: if isAuthenticated();
        allow delete: if isOwner(resource.data.authorUid) || isPlatformAdmin();
      }
    }

    // Verified Freight Jobs
    match /jobs/{jobId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.posterUid == request.auth.uid;
      allow update, delete: if isOwner(resource.data.posterUid) || isPlatformAdmin();
    }

    // Reverse Auctions & Multi-Container Tenders
    match /auctions/{auctionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.creatorUid == request.auth.uid;
      allow update: if isOwner(resource.data.creatorUid) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['publishedAt', 'creatorUid']) || isPlatformAdmin();
      allow delete: if isPlatformAdmin(); // Published auctions are immutable business records

      match /bids/{bidId} {
        allow read: if isAuthenticated() && (
          isOwner(resource.data.bidderUid) || 
          isOwner(get(/databases/$(database)/documents/auctions/$(auctionId)).data.creatorUid) ||
          isPlatformAdmin()
        );
        allow create: if isAuthenticated() && request.resource.data.bidderUid == request.auth.uid;
        allow update: if isPlatformAdmin();
      }

      match /audit/{auditId} {
        allow read: if isAuthenticated() && (
          isOwner(get(/databases/$(database)/documents/auctions/$(auctionId)).data.creatorUid) || 
          isPlatformAdmin()
        );
        allow create: if isAuthenticated();
        allow update, delete: if false; // Strict Immutable Audit Trail
      }
    }

    // Rates Inventory
    match /rates/{rateId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isOwner(resource.data.ownerUid) || isPlatformAdmin();
    }

    // Trade Chat Conversations (Text only, no attachments)
    match /conversations/{conversationId} {
      allow read, write: if isAuthenticated() && (request.auth.uid in resource.data.participantUids || request.auth.uid in request.resource.data.participantUids);

      match /messages/{messageId} {
        allow read: if isAuthenticated() && (request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids);
        allow create: if isAuthenticated() && (request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids) && request.resource.data.senderUid == request.auth.uid;
        allow update: if isOwner(resource.data.senderUid) && request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'readAt']);
        allow delete: if isOwner(resource.data.senderUid) || isPlatformAdmin();
      }
    }

    // Nexus Discussions, Reviews & Blacklist Cases
    match /nexusTopics/{topicId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.authorUid == request.auth.uid;
      allow update: if isAuthenticated();
      allow delete: if isOwner(resource.data.authorUid) || isPlatformAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isPlatformAdmin();
    }

    match /blacklistCases/{caseId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.reporterUid == request.auth.uid;
      allow update, delete: if isPlatformAdmin();
    }

    // Confidential Compliance Reports
    match /reports/{reportId} {
      allow read: if isPlatformAdmin() || isOwner(resource.data.reporterUid);
      allow create: if isAuthenticated() && request.resource.data.reporterUid == request.auth.uid;
      allow update, delete: if isPlatformAdmin();
    }

    // =========================================================================
    // INTELLIGENCE, EVENTS, PRESENCE & EXTENDED WORKFLOWS
    // =========================================================================

    // Idempotent Logistics Telemetry Events (Append-Only)
    match /events/{eventId} {
      allow read: if isPlatformAdmin();
      allow create: if isAuthenticated() && request.resource.data.actorId == request.auth.uid;
      allow update, delete: if false; // Strict Immutability
    }

    // Real Presence Heartbeats (3-State Active/Idle/Away)
    match /presence/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isPlatformAdmin();
    }

    // Configurable Two-Stage Feed Ranking Algorithm
    match /rankingConfigs/{configId} {
      allow read: if isAuthenticated();
      allow write: if isPlatformAdmin();
    }

    // KYC Records & Verification Dossiers
    match /kyc_records/{userId} {
      allow read: if isOwner(userId) || isPlatformAdmin();
      allow create: if isOwner(userId);
      allow update: if isPlatformAdmin() || (isOwner(userId) && resource.data.status != 'verified');
      allow delete: if isPlatformAdmin();
    }

    // Account-Scoped Bidder Groups
    match /bidderGroups/{groupId} {
      allow read: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;
    }

    // Operational Disruptions & Logistics Signals
    match /operationalSignals/{signalId} {
      allow read: if isAuthenticated();
      allow write: if isPlatformAdmin();
    }

    // Model Registry & Algorithm Governance
    match /modelRegistry/{modelId} {
      allow read: if isPlatformAdmin();
      allow write: if isPlatformAdmin();
    }

    // Advertising Campaigns & Settlements
    match /ads/{adId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isPlatformAdmin();
    }
  }
}
