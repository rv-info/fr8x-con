<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Strict Transport Security: Enforce HTTPS and system CA trust -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Explicit domain configuration for production enterprise endpoints -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">con.fr8x.in</domain>
        <domain includeSubdomains="true">fr8x.in</domain>
        <domain includeSubdomains="true">fr8x.app</domain>
        <domain includeSubdomains="true">supabase.co</domain>
    </domain-config>
</network-security-config>

