# FR8X Environment Variables Template
# Copy this file to .env.local and populate all values for your environment.
# DO NOT commit real secrets to source control.
# Store production secrets in Vercel Environment Variables (server-side only).

# ─────────────────────────────────────────────────────────────────────────────
# Firebase Client Configuration (PUBLIC — safe to expose to browser)
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=fr8x-con.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=fr8x-con
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=fr8x-con.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef

# Firebase App Check — reCAPTCHA Enterprise site key (PUBLIC, required for App Check)
# Register your site at: https://console.cloud.google.com/security/recaptcha
NEXT_PUBLIC_FIREBASE_RECAPTCHA_SITE_KEY=

# Google Maps API Key (Places Autocomplete & Geocoding)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSy...

# ─────────────────────────────────────────────────────────────────────────────
# Firebase Admin SDK (SERVER ONLY — Never expose to client)
# ─────────────────────────────────────────────────────────────────────────────
FIREBASE_ADMIN_PROJECT_ID=fr8x-con
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk@fr8x-con.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# ─────────────────────────────────────────────────────────────────────────────
# Zoho Flow Webhook Integration (SERVER ONLY — Never expose to client)
# ─────────────────────────────────────────────────────────────────────────────
ZOHO_SUPPORT_FLOW_WEBHOOK_URL=
ZOHO_PASSWORD_FLOW_WEBHOOK_URL=
ZOHO_FLOW_WEBHOOK_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Official Zoho Mail SMTP Integration (SERVER ONLY)
# ─────────────────────────────────────────────────────────────────────────────
ZOHO_SMTP_HOST=smtp.zoho.in
ZOHO_SMTP_PORT=465
ZOHO_SMTP_SECURE=true
ZOHO_SMTP_USER=password@fr8x.in
ZOHO_SMTP_PASSWORD=
ZOHO_SUPPORT_EMAIL=support@fr8x.in
ZOHO_PASSWORD_EMAIL=password@fr8x.in
ZOHO_SECURITY_EMAIL=tech@fr8x.in

# ─────────────────────────────────────────────────────────────────────────────
# Zoho ZeptoMail REST API (SERVER ONLY)
# NEVER expose to browser, frontend code, localStorage, or NEXT_PUBLIC_ vars.
# NEVER commit the real value to Git.
# Store ONLY in Vercel Environment Variables.
# Agent: agent_1 | Verified Domain: fr8x.in
# API Endpoint: https://api.zeptomail.com/v1.1/email
# SECURITY NOTE: Rotate this key if the .env.local file was ever synced to
# OneDrive, Google Drive, or any cloud storage service.
# ─────────────────────────────────────────────────────────────────────────────
# Primary key name used by email-service.ts and mailer.ts
ZEPTO_MAIL_API_KEY=
# Alias used by some legacy modules (must match ZEPTO_MAIL_API_KEY value)
ZOHO_ZEPTOMAIL_TOKEN=
ZEPTO_MAIL_API_URL=https://api.zeptomail.com/v1.1/email
ZEPTO_MAIL_FROM_NAME=FR8X
ZEPTO_MAIL_PASSWORD_FROM=password@fr8x.in
ZEPTO_MAIL_SUPPORT_FROM=support@fr8x.in
ZEPTO_MAIL_TECH_FROM=tech@fr8x.in
ZEPTO_MAIL_BOUNCE_ADDRESS=

# Sender address aliases
ZEPTO_PASSWORD_FROM_ADDRESS=password@fr8x.in
ZEPTO_SUPPORT_FROM_ADDRESS=support@fr8x.in
ZEPTO_TECH_FROM_ADDRESS=tech@fr8x.in

# ─────────────────────────────────────────────────────────────────────────────
# Email Dev/Test Behavior
# SECURITY: Set to 'false' in ALL non-development environments.
# When 'true' in development only, email failures return mock success for faster iteration.
# NEVER set to 'true' in production (Vercel) — failures must be surfaced accurately.
# ─────────────────────────────────────────────────────────────────────────────
ALLOW_DEV_EMAIL_FALLBACK=false

# ─────────────────────────────────────────────────────────────────────────────
# Application Public Base URL (used for verification & reset links in emails)
# ─────────────────────────────────────────────────────────────────────────────
APP_URL=
NEXT_PUBLIC_APP_URL=

# ─────────────────────────────────────────────────────────────────────────────
# GODFATHER Encryption & Privileged Session Secrets (SERVER ONLY)
# SECURITY: GODFATHER_KMS_ENCRYPTION_KEY must be a unique 64-char hex string.
# Using the default hardcoded value in production is a CRITICAL security risk.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ─────────────────────────────────────────────────────────────────────────────
GODFATHER_KMS_ENCRYPTION_KEY=
GODFATHER_SESSION_SECRET=
GODFATHER_OPERATOR_EMAIL=
GODFATHER_OPERATOR_PASSWORD_SALT=
GODFATHER_OPERATOR_PASSWORD_HASH=
GODFATHER_LOCKOUT_MAX_ATTEMPTS=5
GODFATHER_LOCKOUT_DURATION_MINUTES=30

# ─────────────────────────────────────────────────────────────────────────────
# Redis (Optional — for distributed OTP store & rate limiting in production)
# Without REDIS_URL, OTP and rate limits use in-memory store (lost on cold start).
# For Vercel: use Vercel KV (Redis-compatible) or Upstash Redis.
# ─────────────────────────────────────────────────────────────────────────────
REDIS_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Development / Emulator Mode
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_EMULATOR=false

# ─────────────────────────────────────────────────────────────────────────────
# CSRF Token Signing Secret (SERVER ONLY)
# SECURITY: Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set ONLY in Vercel encrypted env vars. Never commit.
# ─────────────────────────────────────────────────────────────────────────────
CSRF_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# ZeptoMail Delivery Webhook Shared Secret (SERVER ONLY)
# Used to authenticate POST /api/email/webhook from ZeptoMail.
# Set in ZeptoMail console as custom header: X-ZeptoMail-Webhook-Token
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ─────────────────────────────────────────────────────────────────────────────
ZEPTO_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Vercel KV — Distributed OTP Store (PRODUCTION REQUIRED)
# Required to enforce OTP rate limits across Vercel serverless invocations.
# Without this, rate limits fall back to in-memory (NOT safe on Vercel).
# Provision at: https://vercel.com/dashboard/stores
# These values are automatically set when you link a Vercel KV store.
# ─────────────────────────────────────────────────────────────────────────────
KV_REST_API_URL=
KV_REST_API_TOKEN=
