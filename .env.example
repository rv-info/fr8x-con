# ═══════════════════════════════════════════════════════════════
# FR8X-CON Environment Variables — Production Configuration
# Copy this to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# ═══════════════════════════════════════════════════════════════

# ── Firebase Client Configuration ──
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ── Firebase App Check (reCAPTCHA v3) ──
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# ── Firebase Web Push (FCM VAPID) ──
NEXT_PUBLIC_FIREBASE_FCM_VAPID_KEY=

# ── Firebase Admin SDK (Server-side only — never expose publicly) ──
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── App Configuration ──
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_VERSION=v1.0.0
NEXT_PUBLIC_APP_NAME=FR8X-CON

# ── Email — Zoho SMTP Configuration ──
# Alternatively configure RESEND_API_KEY or SENDGRID_API_KEY
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=
ZOHO_SMTP_PASS=

# ── OTP Security ──
# HMAC secret for OTP hashing. Use a long random string (min 32 chars).
OTP_SECRET_KEY=change-this-to-a-long-random-secret-in-production

# ── Rate Limiting ──
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# ── Payment Gateway — Razorpay ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Currency Exchange API ──
NEXT_PUBLIC_CURRENCY_API_BASE_URL=https://api.exchangerate-api.com/v4/latest
CURRENCY_API_KEY=

# ── GodMode Additional Security (optional) ──
# Extra JWT signing key for GodMode session tokens
GODMODE_JWT_SECRET=change-this-to-a-long-random-secret-in-production
