{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fr8x-con",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "con.fr8x.in",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
