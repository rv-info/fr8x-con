rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Ad Creatives (237x299 px PNG or GIF only)
    match /adCreatives/{adId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null &&
        (request.resource.contentType == 'image/png' || request.resource.contentType == 'image/gif') &&
        request.resource.size < 2 * 1024 * 1024;
    }

    // KYC Compliance Documents (PDF, JPEG, PNG, WEBP max 10MB)
    match /kyc/{companyId}/{fileName} {
      allow read: if request.auth != null && (
        request.auth.uid == companyId ||
        request.auth.token.companyId == companyId ||
        request.auth.token.role == 'super_admin' ||
        request.auth.token.role == 'godfather'
      );
      allow write: if request.auth != null && (
        request.auth.uid == companyId ||
        request.auth.token.companyId == companyId ||
        request.auth.token.role == 'super_admin' ||
        request.auth.token.role == 'godfather'
      ) && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/(jpeg|png|webp)');
    }

    // Profile Avatars
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId &&
        request.resource.contentType.matches('image/.*') &&
        request.resource.size < 5 * 1024 * 1024;
    }
  }
}
